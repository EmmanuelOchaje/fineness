# ─── Arc mainnet ──────────────────────────────────────────────────────────────
# Chain ID 5042. Gas is paid in USDC, not ETH.
ARC_RPC_URL=https://rpc.mainnet.arc.io

# REQUIRED for the indexer.
# Circle's public RPC does NOT serve WebSocket — only Alchemy, Blockdaemon and
# QuickNode do. Pool discovery cannot run without one of these.
#   wss://arc-mainnet.g.alchemy.com/v2/YOUR_KEY
#   wss://rpc.blockdaemon.mainnet.arc.io/websocket
#   wss://rpc.quicknode.mainnet.arc.io
ARC_WSS_URL=

# ─── Deployment ───────────────────────────────────────────────────────────────
# Deployer key. NEVER commit a real value. The wallet needs Arc USDC for gas.
DEPLOYER_PRIVATE_KEY=

# ─── Indexer ──────────────────────────────────────────────────────────────────
DATABASE_PATH=./indexer/fineness.sqlite

# ─── Context layer (optional — the app must work without it) ──────────────────
# Paid and rate-limited. Absent is a supported state, not an error.
X_API_BEARER_TOKEN=
